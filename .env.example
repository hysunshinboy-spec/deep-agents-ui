# Copy to .env.local and restart `yarn dev` after editing.
# Settings saved in the UI take precedence over these values.

# LangGraph deployment to connect to.
NEXT_PUBLIC_DEPLOYMENT_URL="http://127.0.0.1:2024"

# Assistant UUID, or a graph name from the `graphs` key of langgraph.json.
NEXT_PUBLIC_ASSISTANT_ID="research_agent"

# Optional. Required for LangSmith / LangGraph Platform deployments.
NEXT_PUBLIC_LANGSMITH_API_KEY=""
